# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Backend / Vercel Production Auth & API Configuration
# SESSION_SECRET: Khóa bí mật ký cookie phiên HttpOnly (khuyến nghị đặt trên Vercel Production)
# SESSION_SECRET=""
# VITE_API_BASE_URL: Chỉ đặt nếu frontend (Vercel) gọi backend ở tên miền khác; để trống nếu cùng tên miền
# VITE_API_BASE_URL=""
# CORS_ORIGINS: Danh sách tên miền frontend được phép gọi kèm cookie (phân tách bằng dấu phẩy)
# CORS_ORIGINS=""

# Optional Server-Side Google Drive Word Attachment Configuration
# MAX_WORD_UPLOAD_MB="10"
# GOOGLE_DRIVE_ENABLED="false"
# GOOGLE_DRIVE_AUTH_MODE="apps_script" # or "service_account"
# GOOGLE_DRIVE_FOLDER_ID=""
# GOOGLE_DRIVE_APPS_SCRIPT_URL=""
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=""

# Durable Server Storage for Vercel Production (bắt buộc một trong các tùy chọn sau trên Vercel để lưu bền vững giữa các lần đăng nhập/tải lại):
# Tùy chọn 1 (Khuyên dùng): Upstash Redis / Vercel KV REST API
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# (Hoặc dùng bộ biến chuẩn của Upstash Redis)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# PERSISTENT_DB_KEY="nct_vanban_registry_db_v1"
#
# Tùy chọn 2: Vercel Blob Store
# BLOB_READ_WRITE_TOKEN=""
# PERSISTENT_BLOB_PATHNAME="nct-registry/db.json"
#
# Tùy chọn 3: Remote Storage Webhook (Apps Script / API riêng)
# PERSISTENT_DB_WEBHOOK_URL=""
# PERSISTENT_DB_SECRET=""

